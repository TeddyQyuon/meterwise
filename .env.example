PORT=3001
HOST=127.0.0.1
# Exact frontend origins allowed to write through the local development proxy.
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://terminal.local:4173
# SQLite runs immediately with no database account required.
DB_DIALECT=sqlite
SQLITE_PATH=data/meterwise.sqlite
# To use MySQL, create a database named meterwise and change DB_DIALECT to mysql.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=meterwise
DB_USER=root
DB_PASSWORD=

# Vercel server environment only. Never prefix database credentials with VITE_.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
