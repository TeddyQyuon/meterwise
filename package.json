{
  "name": "meterwise",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite --host 0.0.0.0 --port 5173",
    "dev:server": "python -m uvicorn backend.app:app --reload --host 127.0.0.1 --port 3001",
    "build": "vite build",
